# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables (secrets)
.env
.env.local
.env.*.local

# ML training data & model binaries (large files).
# Also covers backend/data/ratings.jsonl - human sunset ratings are the user's
# own observations and are not committed.
# Excluding the CONTENTS rather than the directory itself, because git cannot
# re-include anything inside an excluded directory.
backend/data/*
# ...except the record of the shelved ML experiment, which is documentation,
# not data. Without this, the "why we don't use ML" note is invisible in the
# repo and the next person re-runs the same failed experiment.
!backend/data/dead/
# Uncomment the line below if you want to exclude the model from git.
# If you want to deploy with the model, keep it commented out and commit the .joblib file.
# For files >100MB, use git lfs: git lfs track "*.joblib"
# backend/trained_models/*.joblib

# Logs
*.log
/tmp/

# Node
frontend/node_modules/
frontend/.next/
# Next.js sometimes writes a stray .next/ under backend/ when the dev server is
# launched from the repo root. Ignore it anywhere rather than per-directory.
.next/
frontend/out/
frontend/.turbo/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/settings.json
.idea/

# Claude internal
.claude/

# Docker
*.tar

# Human sunset ratings — real labels, not code. Kept out of git so a test run,
# a UI verification pass or a demo cannot commit fabricated observations into
# the one dataset that measures whether the model is actually right.
data/ratings.jsonl
